# Copy to .env.local and fill in. Never commit .env.local.
# On Netlify these go in Site settings → Environment variables.

# ─── Site ────────────────────────────────────────────────────────────────────
# Canonical public origin. Used to build the URLs iPay redirects customers back
# to. Leave UNSET on Netlify deploy previews so DEPLOY_PRIME_URL is used instead.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ─── Sanity (CMS + order storage) ────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
# Write token — creates orders and records payments. Server-only.
SANITY_API_TOKEN=
# Read token for draft mode / visual editing.
SANITY_API_READ_TOKEN=

# ─── iPay payment gateway ────────────────────────────────────────────────────
# Leave these blank to run with Cash on Delivery only; the iPay option fails
# closed and tells the customer to use COD.
#
# Get them from the iPay merchant portal:
#   Merchant Settings → Development Settings → Developer Portal
#   → Payment Integration → IPG Payments
# While you're there, set the Call back API URL to:
#   https://<your-domain>/api/ipay/notify
# and enable the checksum ("Additional Security") option.
#
# sandbox | live. Anything other than "live" uses the sandbox gateway.
IPAY_ENV=sandbox
# The generated IPG Integration Token.
IPAY_MERCHANT_TOKEN=
# The Secret you set in the portal. Signs and verifies payment amounts —
# server-only, never expose this to the browser.
IPAY_SECRET=
# Optional override for the checkout URL. Only set this if iPay tells you to.
# IPAY_CHECKOUT_URL=

# ─── Order lookup ────────────────────────────────────────────────────────────
# Signs the token that guards order status pages, so an order number alone
# can't be used to read someone's order. Any long random string:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ORDER_LOOKUP_SECRET=

# ─── Resend transactional email (order confirmations) ────────────────────────
RESEND_API_KEY=
# Must use a domain verified in your Resend account, e.g. "NUZII <orders@yourdomain.com>"
EMAIL_FROM=
# Where new-order notifications go.
EMAIL_ADMIN_TO=

# ─── Firebase (optional customer sign-in) ────────────────────────────────────
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
